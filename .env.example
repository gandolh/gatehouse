# The API's settings. Copy to .env (never committed) and fill in what you need: an empty value means the default, and
# a variable the environment sets wins over this file.

# Where the API listens. Default 127.0.0.1; the container sets 0.0.0.0.
HOST=
# Default 8815.
PORT=

# The page's origin as the browser sees it, bare (no path, no trailing slash). Default http://localhost:5182.
PUBLIC_ORIGIN=
# Where the browser reaches the API. Default /gatehouse-api.
GATEHOUSE_API_PREFIX=
# The API's data folder: one SQLite file of Ward's sessions and users. Default data/ at the repo root (gitignored); a
# relative path is taken from the repo root. The container sets /data.
GATEHOUSE_DATA_DIR=
# The card list the owner route reads once at start. Default content/cards.json at the repo root; a relative path is
# taken from the repo root.
GATEHOUSE_CARDS_FILE=

# Sign in with Ward, the only way in: there are no local accounts. Leave WARD_OIDC_ISSUER empty to run without it
# (the API starts and answers health; nobody can sign in). With it set, the client id, the key and the redirect URI
# must be set too. Locally: the Gatehouse client in Ward's local seed.
# Ward's issuer, ending in /oidc (http only on loopback).
WARD_OIDC_ISSUER=
# Gatehouse's client id at Ward: gatehouse.
WARD_OIDC_CLIENT_ID=
# A secret: the client's private key, from Ward's `npm run oidc-client-key`. Never commit it.
WARD_OIDC_CLIENT_KEY=
# PUBLIC_ORIGIN, then /gatehouse-api/auth/ward/callback. Locally http://localhost:5182/gatehouse-api/auth/ward/callback.
WARD_OIDC_REDIRECT_URI=
# PUBLIC_ORIGIN, then /. Optional.
WARD_OIDC_POST_LOGOUT_REDIRECT_URI=

# Peers besides loopback whose X-Forwarded-For the sign-in lockout believes: addresses or CIDR ranges,
# comma-separated. Empty locally; in the container, the range Caddy reaches it from.
AUTH_TRUSTED_PROXIES=

# Not read from this file: `npm run build` takes GATEHOUSE_ORIGIN, the domain's origin, from the environment only
# (vps-deploy passes it), and fails without it.
