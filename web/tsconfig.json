{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    // The page's code, and the build scripts beside it, which Node runs as they are (type stripping): they import each
    // other with the `.ts` suffix.
    "types": ["vite/client", "node"],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "../node_modules/.tmp/web.tsbuildinfo"
  },
  "include": ["src", "scripts", "vite.config.ts"]
}
